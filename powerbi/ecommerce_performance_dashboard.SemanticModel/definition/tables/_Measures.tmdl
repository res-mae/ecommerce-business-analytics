table _Measures
	lineageTag: 80501371-48bf-4857-9c2e-dfa535326699

	measure 'Net Sales (orders)' = SUM('analytics sales'[net_sales])
		formatString: #,0.00
		lineageTag: fbdc0aef-3e72-454e-bfd3-ced8c78afceb

	measure 'Profit (orders)' = SUM('analytics sales'[profit])
		formatString: #,0.00
		lineageTag: 33ec5be7-09f5-4515-8d00-9d1492138395

	measure Orders = DISTINCTCOUNT('analytics sales'[order_id])
		formatString: #,0
		lineageTag: 17e87332-de40-46c8-bfe6-cd925a2c9186

	measure 'Active Customers' = DISTINCTCOUNT('analytics sales'[customer_id])
		formatString: #,0
		lineageTag: f7330b74-5ce8-4911-a369-c55ea16ff93a

	measure AOV = DIVIDE([Net Sales (orders)], [Orders])
		formatString: #,0.00
		lineageTag: 844ad15a-9a46-41d1-90e6-03c6a3c27ad0

	measure 'Return Rate' =
			
			DIVIDE (
			    CALCULATE(
			        DISTINCTCOUNT('analytics sales'[order_id]),
			        'analytics sales'[order_status] = "Returned"
			    ),
			    [Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b9b8779f-4a67-4617-802e-9cdef988c666

	measure 'Cancellation Rate' =
			
			DIVIDE (
			    CALCULATE(
			        DISTINCTCOUNT('analytics sales'[order_id]),
			        'analytics sales'[order_status] = "Cancelled"
			    ),
			    [Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: dce36a12-910a-444f-b00f-36072d01e7b7

	measure 'Profit % of Net Sales' = DIVIDE([Profit (orders)], [Net Sales (orders)])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 289677b2-a6a8-4034-87f3-0d0953e30a78

	measure 'Net Sales (items)' = SUM('analytics order_items'[net_sales])
		formatString: #,0.00
		lineageTag: 911ee4d6-ecd2-4fb2-8d22-29ab128b396f

	measure 'Profit (items)' = SUM('analytics order_items'[profit])
		formatString: #,0.00
		lineageTag: 97e8c78a-9598-45c9-8ad8-3a19bf22448c

	measure 'Product Sales (orders)' = SUM('analytics sales'[gross_sales]) - SUM('analytics sales'[discount_amount])
		formatString: #,0.00
		lineageTag: e7c6057a-84fc-4357-a410-2d6e939328e3

	measure 'Discount % of Gross Sales' = DIVIDE(SUM('analytics sales'[discount_amount]), SUM('analytics sales'[gross_sales]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8e4a94b8-c523-4b32-8852-9d811a6838cc

	measure 'Net Sales PY (orders)' =
			
			CALCULATE(
			    [Net Sales (orders)],
			    SAMEPERIODLASTYEAR('analytics dates'[date])
			)
		formatString: #,0.00
		lineageTag: 5f9edd90-e33a-4064-8690-6516a6ab4a13

	measure 'Net Sales YoY % (orders)' = ```
			
			DIVIDE(
			    [Net Sales (orders)] - [Net Sales PY (orders)], 
			    [Net Sales PY (orders)]
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 67370d2b-98bd-4c1d-b6d6-09f3912659c5

	measure 'Net Sales PM (orders)' =
			
			CALCULATE(
			    [Net Sales (orders)],
			    DATEADD('analytics dates'[date], -1, MONTH)
			)
		formatString: #,0.00
		lineageTag: 3b1c6295-40bd-4410-a3b9-a3f7d725e8d8

	measure 'Net Sales MoM % (orders)' =
			
			DIVIDE(
			    [Net Sales (orders)] - [Net Sales PM (orders)],
			    [Net Sales PM (orders)]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b9b5a07c-24f9-4f08-9472-bb2b36ebdd6d

	measure 'Net Sales (orders, Completed)' = ```
			
			 CALCULATE(
			    SUM('analytics sales'[net_sales]),
			    'analytics sales'[order_status] = "Completed"
			 )
			```
		formatString: #,0.00
		lineageTag: d7fef132-8b54-498b-bf16-ffe4ac97acb4

	measure 'Orders (Completed)' =
			
			CALCULATE(
			    DISTINCTCOUNT('analytics sales'[order_id]),
			    'analytics sales'[order_status] = "Completed"
			)
		formatString: #,0
		lineageTag: a20bf0df-48c0-47d7-b08f-143e1cff1c48

	measure 'Profit (orders, Completed)' =
			
			CALCULATE(
			    SUM('analytics sales'[profit]),
			    'analytics sales'[order_status] = "Completed"
			)
		formatString: #,0.00
		lineageTag: 22bd9f19-1a8a-48bb-a453-374bf362a6b6

	measure 'AOV (Completed)' = ```
			DIVIDE([Net Sales (orders, Completed)], [Orders (Completed)]) 
			```
		formatString: #,0.00
		lineageTag: edd3063f-73fd-404e-91c4-601976e93537

	measure 'Profit % of Net Sales (items)' = DIVIDE([Profit (items)], [Net Sales (items)])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5b40532d-082c-4550-bfde-ab75b8a2ee20

	column Dummy
		formatString: 0
		lineageTag: f59d5a3e-4dee-4fff-b04d-fa648aaf8a41
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Dummy]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source =
				
				SELECTCOLUMNS(
				    FILTER(
				        { (1) },
				        FALSE()
				    ),
				    "Dummy", [Value]
				)

	annotation PBI_Id = eb05f3be0d564a98babea3185edda928

